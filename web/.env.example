# Database (Neon Postgres, pooled)
DATABASE_URL='postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require'

# S3-compatible storage (Neon Object Storage)
AWS_ENDPOINT_URL_S3="https://BUCKET-ID.storage.REGION.aws.neon.tech"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-2"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-32-char-min-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Master admin — the single web console account (seeded by `pnpm seed:admin`)
MASTER_ADMIN_NAME="Master Admin"
MASTER_ADMIN_EMAIL="admin@urban.bee"
MASTER_ADMIN_PASSWORD="change-me"

# Cloudflare Workers AI (triage pipeline). Leave empty to fall back to keyword rules,
# or run `npx wrangler login` and the server will use that login.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model overrides
# CF_DECISION_MODEL=clef
# CF_TEXT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# CF_STT_MODEL=@cf/openai/whisper-large-v3-turbo

# Who may open the dashboard (comma separated). Empty = any signed-in account.
ADMIN_EMAILS=

# Media storage on serverless hosts (Vercel): S3 bucket for photos and voice notes.
# Used automatically in production; set MEDIA_DRIVER=fs to force local disk, =s3 to test S3 locally.
MEDIA_BUCKET=urbanbee-media
